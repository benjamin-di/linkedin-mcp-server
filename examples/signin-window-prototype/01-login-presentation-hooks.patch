--- /dev/null
+++ b/linkedin_mcp_server/login_hooks.py
@@ -0,0 +1,36 @@
+"""Optional presentation hooks; browser and session ownership stay with login."""
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Literal, Protocol
+
+
+@dataclass(frozen=True)
+class LoginProgress:
+    """Public progress only: no page content, cookies, profile path or credentials.
+
+    ``saving`` precedes cookie export; ``closed`` reports teardown evidence.
+    A saved session requires a true return from ``interactive_login`` and
+    confirmed closure. Progress alone never asserts successful publication.
+    """
+
+    state: Literal["waiting", "saving", "closed"]
+    host: str = ""
+    close_confirmed: bool | None = None
+
+
+LoginObserver = Callable[[LoginProgress], None]
+
+
+class LoginView(Protocol):
+    """A presentation surface whose resources the login lifecycle closes."""
+
+    def start_window_manager(self) -> None: ...
+
+    def start_remote_control(self) -> str | None:
+        """Return a CLI viewer address, or None when the host already serves it."""
+        ...
+
+    def stop_remote_control(self) -> None: ...
+
+    def stop_window_manager(self) -> None: ...
