diff --git a/tests/test_login_hooks.py b/tests/test_login_hooks.py
new file mode 100644
index 0000000..2348e6f
--- /dev/null
+++ b/tests/test_login_hooks.py
@@ -0,0 +1,220 @@
+"""Presentation observes the existing login without owning its profile lifetime."""
+
+from dataclasses import asdict
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from linkedin_mcp_server import setup
+from linkedin_mcp_server.config.schema import AppConfig
+from linkedin_mcp_server.login_hooks import LoginProgress
+
+
+@pytest.fixture
+def login(monkeypatch, tmp_path):
+    trace = []
+    config = AppConfig()
+    config.browser.chrome_path = "/synthetic/chrome"
+    config.browser.proxy_server = "http://proxy.example:8080"
+    browser = SimpleNamespace(
+        page=SimpleNamespace(url="https://www.linkedin.com/login"),
+        context=SimpleNamespace(
+            cookies=AsyncMock(
+                return_value=[{"name": "li_at", "value": "synthetic-cookie"}]
+            )
+        ),
+        export_cookies=AsyncMock(
+            side_effect=lambda *args: trace.append("export") or True
+        ),
+    )
+    managers = []
+
+    class Manager:
+        def __init__(self, **kwargs):
+            self.kwargs = kwargs
+            self.close_confirmed = False
+            self.confirm_close = True
+            managers.append(self)
+
+        async def __aenter__(self):
+            trace.append("browser-open")
+            return browser
+
+        async def __aexit__(self, *args):
+            trace.append("browser-close")
+            self.close_confirmed = self.confirm_close
+
+    lease = SimpleNamespace(
+        acquire=AsyncMock(return_value=True),
+        guardian_fd=lambda: None,
+        mark_browser_open=lambda: trace.append("mark-open"),
+        mark_browser_closed=lambda: trace.append("mark-closed"),
+        release=lambda: trace.append("lease-release"),
+    )
+    monkeypatch.setattr(setup, "get_config", lambda: config)
+    monkeypatch.setattr(setup, "BrowserManager", Manager)
+    monkeypatch.setattr(setup, "get_profile_lease", lambda *args: lease)
+    monkeypatch.setattr(setup, "close_browser", AsyncMock())
+    monkeypatch.setattr(
+        setup, "rotate_shielded", AsyncMock(return_value=tmp_path / "retired")
+    )
+    restore = MagicMock(side_effect=lambda *args: trace.append("restore") or True)
+    monkeypatch.setattr(setup, "restore_source_profile", restore)
+    monkeypatch.setattr(setup, "start_browser_guardian", lambda *args: None)
+    monkeypatch.setattr(
+        setup, "release_browser_guardian", lambda: trace.append("guardian-release")
+    )
+    monkeypatch.setattr(setup, "goto_reporting_proxy_errors", AsyncMock())
+    monkeypatch.setattr(
+        setup, "resolve_remember_me_prompt", AsyncMock(return_value=True)
+    )
+    monkeypatch.setattr(setup, "wait_for_manual_login", AsyncMock())
+    monkeypatch.setattr(setup.asyncio, "sleep", AsyncMock())
+    monkeypatch.setattr(
+        setup,
+        "write_source_state",
+        lambda *args: (
+            trace.append("publish")
+            or SimpleNamespace(login_generation="synthetic-generation")
+        ),
+    )
+
+    class Viewer:
+        def start_window_manager(self):
+            trace.append("wm-start")
+
+        def start_remote_control(self):
+            trace.append("view-start")
+            return None
+
+        def stop_remote_control(self):
+            trace.append("view-stop")
+
+        def stop_window_manager(self):
+            trace.append("wm-stop")
+
+    return SimpleNamespace(
+        trace=trace,
+        browser=browser,
+        managers=managers,
+        config=config,
+        viewer=Viewer,
+        restore=restore,
+        lease=lease,
+        profile=tmp_path / "profile",
+    )
+
+
+@pytest.mark.asyncio
+async def test_progress_closes_only_after_browser_and_lease_cleanup(login, capsys):
+    events = []
+
+    def observe(event):
+        events.append(event)
+        login.trace.append(event.state)
+
+    assert await setup.interactive_login(
+        login.profile, login_viewer=True, viewer_factory=login.viewer, observer=observe
+    )
+    trace = login.trace
+    assert (
+        trace.index("waiting")
+        < trace.index("saving")
+        < trace.index("export")
+        < trace.index("publish")
+    )
+    assert (
+        trace.index("view-stop") < trace.index("browser-close") < trace.index("wm-stop")
+    )
+    assert trace.index("wm-stop") < trace.index("lease-release") < trace.index("closed")
+    assert events[-1].close_confirmed is True
+    assert events[0].host == "www.linkedin.com"
+    for event in events:
+        assert set(asdict(event)) == {"state", "host", "close_confirmed"}
+        assert "synthetic-cookie" not in str(event) and str(login.profile) not in str(
+            event
+        )
+    assert "loopback URL" not in capsys.readouterr().out
+    options = login.managers[0].kwargs
+    assert options["executable_path"] == "/synthetic/chrome"
+    assert options["proxy"] == {"server": "http://proxy.example:8080"}
+    assert options["headless"] is False
+    assert "user_agent" not in options and "env" not in options
+
+
+@pytest.mark.asyncio
+async def test_observer_failure_before_export_runs_normal_restore(login):
+    def observe(event):
+        if event.state == "saving":
+            raise RuntimeError("synthetic observer failure")
+
+    with pytest.raises(RuntimeError, match="observer failure"):
+        await setup.interactive_login(
+            login.profile,
+            login_viewer=True,
+            viewer_factory=login.viewer,
+            observer=observe,
+        )
+    login.browser.export_cookies.assert_not_awaited()
+    login.restore.assert_called_once()
+    assert (
+        login.trace.index("browser-close")
+        < login.trace.index("restore")
+        < login.trace.index("lease-release")
+    )
+
+
+@pytest.mark.asyncio
+async def test_failed_export_keeps_failure_and_restores_the_previous_session(login):
+    events = []
+    login.browser.export_cookies.side_effect = lambda *args: False
+    assert not await setup.interactive_login(
+        login.profile,
+        login_viewer=True,
+        viewer_factory=login.viewer,
+        observer=events.append,
+    )
+    login.restore.assert_called_once()
+    assert "publish" not in login.trace
+    assert events[-1] == LoginProgress("closed", close_confirmed=True)
+
+
+@pytest.mark.asyncio
+async def test_unconfirmed_teardown_is_reported_without_releasing_the_profile(login):
+    events = []
+
+    def observe(event):
+        events.append(event)
+        if event.state == "waiting":
+            login.managers[0].confirm_close = False
+
+    await setup.interactive_login(
+        login.profile, login_viewer=True, viewer_factory=login.viewer, observer=observe
+    )
+    assert events[-1] == LoginProgress("closed", close_confirmed=False)
+    assert "lease-release" not in login.trace and "guardian-release" not in login.trace
+    login.restore.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_post_cleanup_observer_failure_does_not_undo_a_saved_session(
+    login, caplog
+):
+    def observe(event):
+        if event.state == "closed":
+            raise RuntimeError("synthetic-cookie must not enter logs")
+
+    assert await setup.interactive_login(
+        login.profile, login_viewer=True, viewer_factory=login.viewer, observer=observe
+    )
+    assert "publish" in login.trace and "lease-release" in login.trace
+    assert "synthetic-cookie" not in caplog.text
+    login.restore.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_injected_viewer_requires_explicit_viewer_mode(login):
+    with pytest.raises(ValueError, match="login_viewer"):
+        await setup.interactive_login(login.profile, viewer_factory=login.viewer)
+    assert login.managers == []
